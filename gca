#!/bin/bash
# gca — Git Commit com IA (gera mensagem + commita)
# Uso: gca [--commit] [--stage-all]
#
# Sem argumentos: usa --stage-all (git add -A + commit)
# --commit: apenas commita (sem stage automático)
# --stage-all: força stage explícito (default)

SCRIPT="/home/val/Documentos/Notepad/X/Scripts/generate_commit_msg.py"

echo "🐙 gerando mensagem de commit..."

# Se nenhum argumento foi passado, usa --stage-all como default
if [ $# -eq 0 ]; then
    exec python3 "$SCRIPT" --stage-all
else
    exec python3 "$SCRIPT" "$@"
fi
